{
  "title": "API Gateway Overview",
  "uid": "api-gateway-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Targets Up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP Request Rate (security, uploader)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count[1m])) by (app_name)",
          "legendFormat": "{{app_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Errors 5xx Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[1m])) by (app_name)",
          "legendFormat": "{{app_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "MinIO Cluster Usable Capacity",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "minio_cluster_usable_capacity_bytes",
          "legendFormat": "usable capacity",
          "refId": "A"
        }
      ]
    }
  ]
}
